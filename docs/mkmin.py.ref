import struct, blake3, sys

def b3(b): return blake3.blake3(b).digest()
def pad8(b): return b + b"\0" * ((-len(b)) % 8)

# ---- content of the minimal skill ----
NAME = "demo"
DESC = "Use when demonstrating the skill format."
BODY = b"Do the thing.\n"

# ---- string heap: sorted, deduped, NFC ----
strs = sorted({NAME, DESC})
enc = [s.encode() for s in strs]
offs, cur = [], 0
for e in enc:
    offs.append(cur); cur += len(e)
offs.append(cur)
heap = struct.pack("<I", len(enc)) + b"".join(struct.pack("<I", o) for o in offs) + b"".join(enc)
heap = pad8(heap)
idx = {s: i for i, s in enumerate(strs)}

# ---- payload regions ----
hot = b""                      # tier 0 payloads (none: name/desc live in manifest)
cold = pad8(BODY)              # tier 1 body

# ---- hashes: subtree hash of node 0 ----
node0_sub = b3(BODY)
hashes = struct.pack("<I", 1) + b"\0"*4 + node0_sub

# ---- nodes: 32B each ----
KIND_PROSE, ROLE_INTENT, TIER_BODY = 2, 1, 1
node0 = struct.pack("<BBBBHHIIIIII",
    KIND_PROSE, TIER_BODY, 0, 0,   # kind, tier, flags, depth
    ROLE_INTENT, 0,                # role, edge_cnt
    idx[NAME],                     # name -> string heap
    0,                             # edge_off
    0, len(BODY),                  # payload_off (into COLD), payload_len
    0,                             # hash_idx
    0xFFFFFFFF)                    # parent = none (root)
assert len(node0) == 32, len(node0)
nodes = node0
edges = b""

# ---- manifest ----
SECTS = [(1, heap), (2, nodes), (4, hashes)]   # STRINGS, NODES, HASHES
MH = 48
dirlen = 16 * len(SECTS)
body_off = MH + dirlen
sec_off, blobs = {}, b""
for sid, data in SECTS:
    sec_off[sid] = body_off + len(blobs)
    blobs += pad8(data)
mlen_tables = body_off + len(blobs)

# payload regions follow the manifest in the file
manifest_off = 0x40           # sigblock is empty (sig_count=0)
hot_off  = manifest_off + mlen_tables
cold_off = hot_off + len(hot)
file_len = cold_off + len(cold)

counts = {1: len(enc), 2: 1, 4: 1}
mhdr = struct.pack("<HHIIIIIIIII8x",
    len(SECTS), 0,
    idx[NAME], idx[DESC], 0xFFFFFFFF, 0xFFFFFFFF,
    1,                                  # node_count
    hot_off, len(hot), cold_off, len(cold))
assert len(mhdr) == MH, len(mhdr)
mdir = b"".join(struct.pack("<HHIII", sid, 0, sec_off[sid], len(d), counts[sid]) for sid, d in SECTS)
manifest = mhdr + mdir + blobs
assert len(manifest) == mlen_tables

mroot = b3(manifest)

hdr = struct.pack("<8sHHIIIIHH32s",
    b"\x8fSKL\r\n\x1a\n", 1, 0, 0,
    file_len, manifest_off, len(manifest), 0, 0, mroot)
assert len(hdr) == 64, len(hdr)

out = hdr + manifest + hot + cold
assert len(out) == file_len, (len(out), file_len)
open(sys.argv[1], "wb").write(out)
print("file_len", file_len, "manifest_len", len(manifest), "manifest_root", mroot.hex())
